{
  "openapi": "3.1.0",
  "info": { "title": "Obico Bridge", "version": "0.1.6" },
  "paths": {
    "/notification-providers": {
      "get": {
        "operationId":"listObicoNotificationProviders",
        "summary":"List configured notification providers",
        "description":"Lists supported providers whose required settings are present on the Obico server.",
        "responses":{"200":{"description":"Provider names"},"404":{"description":"Not available to this caller"},"502":{"description":"Obico unavailable"}}
      },
      "post": {
        "operationId":"createObicoNotificationChannel",
        "summary":"Add a notification channel",
        "description":"Creates an Obico notification channel in the disabled state so an administrator can review it before enabling delivery.",
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"enum":["discord","email","telegram","pushover"]},"credential":{"type":"string","writeOnly":true}}}}}},
        "responses":{"204":{"description":"Disabled channel created"},"400":{"description":"Invalid provider or credential"},"404":{"description":"Not available to this caller"},"502":{"description":"Obico rejected the channel"}}
      }
    },
    "/notifications": {
      "get": {
        "operationId": "listObicoNotifications",
        "summary": "List configured Obico channels and event settings for administrators",
        "description": "Returns existing channel names and event preferences to callers who may configure extensions.",
        "responses": {"200":{"description":"Notification channels"},"404":{"description":"Not available to this caller"},"409":{"description":"Obico API not configured"},"502":{"description":"Obico unavailable"}}
      }
    },
    "/notifications/{channel}": {
      "post": {
        "operationId": "setObicoNotificationEvents",
        "summary": "Change event settings for an existing Obico channel",
        "description": "Updates event preferences on the paired Obico account without changing the channel configuration.",
        "parameters": [{"name":"channel","in":"path","required":true,"schema":{"type":"integer"}}],
        "requestBody": {"required":true,"content":{"application/json":{"schema":{"type":"object","minProperties":1,"additionalProperties":false,"properties":{
          "enabled":{"type":"boolean"},"notify_on_failure_alert":{"type":"boolean"},"notify_on_print_done":{"type":"boolean"},"notify_on_print_start":{"type":"boolean"},
          "notify_on_print_cancelled":{"type":"boolean"},"notify_on_print_pause":{"type":"boolean"},"notify_on_print_resume":{"type":"boolean"},
          "notify_on_filament_change":{"type":"boolean"},"notify_on_heater_status":{"type":"boolean"}
        }}}}},
        "responses": {"204":{"description":"Settings saved"},"400":{"description":"Invalid settings"},"404":{"description":"Channel unavailable"},"409":{"description":"Obico API not configured"},"502":{"description":"Obico rejected the update"}}
      }
    },
    "/printers/{device}/monitoring": {
      "post": {
        "operationId": "setObicoPrinterMonitoring",
        "summary": "Change AI monitoring for a mapped device",
        "description": "Changes monitoring or alerts for a printer the caller may operate in Connect Local.",
        "parameters": [{"name":"device","in":"path","required":true,"schema":{"type":"string"}}],
        "requestBody": {"required":true,"content":{"application/json":{"schema":{
          "oneOf":[
            {"type":"object","required":["watching"],"properties":{"watching":{"type":"boolean"}},"additionalProperties":false},
            {"type":"object","required":["print_id","muted"],"properties":{"print_id":{"type":"integer","minimum":1},"muted":{"type":"boolean"}},"additionalProperties":false},
            {"type":"object","required":["print_id","acknowledge"],"properties":{"print_id":{"type":"integer","minimum":1},"acknowledge":{"const":true}},"additionalProperties":false}
          ]
        }}}},
        "responses": {
          "204": {"description":"Monitoring updated"},
          "400": {"description":"Invalid setting"},
          "404": {"description":"No operable mapped printer"},
          "409": {"description":"Obico API not configured or the active print or alert changed"},
          "502": {"description":"Obico rejected the setting"}
        }
      }
    },
    "/printers/{device}/obico": {
      "get": {
        "operationId": "getObicoPrinterOverview",
        "summary": "Read Obico monitoring and recent prints for a mapped device",
        "description": "Returns Obico detection state and recent prints for a printer visible to the caller.",
        "parameters": [{"name":"device","in":"path","required":true,"schema":{"type":"string"}}],
        "responses": {
          "200": {"description":"Obico monitoring and print history"},
          "404": {"description":"No visible mapped printer"},
          "502": {"description":"Obico data could not be read"}
        }
      }
    },
    "/overview": {
      "get": {
        "operationId": "getBridgeOverview",
        "summary": "Read printer mappings and Obico connection state",
        "description": "Lists mapped printers visible to the caller and shows whether each one is connected to Obico.",
        "responses": {
          "200": {
            "description": "Bridge overview",
            "content": {"application/json": {"schema": {
              "type": "object",
              "required": ["printers"],
              "properties": {"printers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["device_id", "name", "connected", "obico_connected"],
                  "properties": {
                    "device_id": {"type": "string"},
                    "name": {"type": "string"},
                    "connected": {"type": "boolean"},
                    "camera": {"type": "string"},
                    "obico_connected": {"type": "boolean"}
                  }
                }
              }}
            }}}
          }
        }
      }
    }
  }
}
